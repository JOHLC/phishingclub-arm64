# Build stage - builds the Go binary for the target architecture
FROM golang:1.25.1 AS builder

# Build arguments
ARG TARGETARCH
ARG VERSION=unknown
ARG HASH=unknown

WORKDIR /build

# Copy go mod files
COPY backend/go.mod backend/go.sum ./
RUN go mod download

# Copy backend source
COPY backend/ ./

# Build the binary with CGO enabled for SQLite support
# Using native compilation for the target architecture
RUN CGO_ENABLED=1 \
    go build -trimpath \
    -ldflags="-X github.com/phishingclub/phishingclub/version.hash=ph${HASH} -X github.com/phishingclub/phishingclub/version.version=${VERSION}" \
    -tags production -o /phishingclub main.go

# Runtime stage - creates the final minimal image
FROM debian:12-slim

# install ca-certificates for https requests
RUN apt-get update && \
    apt-get install -y ca-certificates tzdata && \
    rm -rf /var/lib/apt/lists/*

# create non-root user
RUN groupadd -g 1000 appuser && \
    useradd -r -u 1000 -g appuser appuser

# set working directory
WORKDIR /app

# copy the binary from builder stage
COPY --from=builder /phishingclub /app/phishingclub

# make binary executable and set ownership
RUN chmod +x /app/phishingclub && \
    chown appuser:appuser /app/phishingclub

# copy entrypoint script
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# expose ports (using non-privileged ports by default)
EXPOSE 8080 8443 8000

ENTRYPOINT ["/entrypoint.sh"]
